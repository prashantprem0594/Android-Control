{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parent-managed local call shortcuts",
  "type": "object", "additionalProperties": false,
  "required": ["version", "contacts"],
  "properties": {
    "version": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "contacts": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "number", "isParent"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 40},
          "number": {"type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$"},
          "isParent": {"type": "boolean"}
        }
      }
    }
  },
  "allOf": [{"if": {"properties": {"version": {"const": 0}}}, "then": {"properties": {"contacts": {"maxItems": 0}}}}],
  "$comment": "Service also rejects duplicate numbers, multiple primary parents, labels over 160 UTF-8 bytes, surrounding whitespace and control/format/line-separator characters. Shortcuts never automatically place or restrict calls."
}
