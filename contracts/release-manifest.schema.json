{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-control.local/contracts/release-manifest.schema.json",
  "title": "Signed App Control release metadata envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "payload", "signature"],
  "properties": {
    "version": {"const": 1},
    "payload": {"type": "string", "minLength": 1, "maxLength": 43691, "pattern": "^[A-Za-z0-9_-]+$"},
    "signature": {"type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$"}
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sequence", "issuedAt", "expiresAt", "origin", "apps"],
      "properties": {
        "version": {"const": 1},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 2100000000},
        "issuedAt": {"type": "string", "format": "date-time"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "origin": {"type": "string", "format": "uri", "pattern": "^https://[a-z0-9.-]+(?::[0-9]+)?$"},
        "apps": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "versionCode", "versionName", "minSdk", "targetSdk", "url", "bytes", "sha256", "signingCertificateSHA256"],
      "properties": {
        "package": {"enum": ["com.appcontrol.parent", "com.appcontrol.child"]},
        "versionCode": {"type": "integer", "minimum": 1, "maximum": 2100000000},
        "versionName": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+\\-]{0,63}$"},
        "minSdk": {"type": "integer", "minimum": 33, "maximum": 100},
        "targetSdk": {"type": "integer", "minimum": 33, "maximum": 100},
        "url": {"type": "string", "format": "uri"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "signingCertificateSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
