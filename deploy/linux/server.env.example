
# Copy to /etc/app-control/server.env (root:appcontrol, mode 0640).
# This is systemd EnvironmentFile syntax, not a shell script. No secret bytes here.
APP_CONTROL_HTTP_ADDRESS=127.0.0.1:8080
APP_CONTROL_DATABASE_PATH=/var/lib/app-control/app-control.db
APP_CONTROL_TRUSTED_PROXY_CIDRS=127.0.0.1/32
APP_CONTROL_REMOTE_CALLS_ENABLED=false
APP_CONTROL_PARENT_FCM_SENDER_ENABLED=false

# Enable parent registration only after installing the existing private 32-byte key.
# APP_CONTROL_PARENT_FCM_TOKEN_KEY_FILE=/etc/app-control/parent-routing-key.bin
# Enable the sender only after real Firebase project/account registration is verified.
# APP_CONTROL_PARENT_FCM_SERVICE_ACCOUNT_FILE=/etc/app-control/parent-firebase-service-account.json
# After verification, change the active sender flag above to true.

# Optional child wake-up adapter; both files are required together.
# APP_CONTROL_FCM_TOKEN_KEY_FILE=/etc/app-control/child-routing-key.bin
# APP_CONTROL_FCM_SERVICE_ACCOUNT_FILE=/etc/app-control/child-firebase-service-account.json

# Optional signed update metadata; configure all four fields together.
# APP_CONTROL_RELEASE_MANIFEST_FILE=/etc/app-control/release-manifest.json
# APP_CONTROL_RELEASE_PUBLIC_KEY_FILE=/etc/app-control/release-public-key.pub
# APP_CONTROL_RELEASE_ORIGIN=https://REPLACE_WITH_CONTROLLED_HOSTNAME
# APP_CONTROL_RELEASE_CERTIFICATE_SHA256=REPLACE_WITH_EXISTING_APK_CERTIFICATE_SHA256
# APP_CONTROL_RELEASE_MIN_SEQUENCE=1
